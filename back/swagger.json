{
  "openapi": "3.0.3",
  "info": {
    "title": "AgendaVest API",
    "version": "2.0.0",
    "description": "Documentação oficial da API AgendaVest"
  },
  "servers": [
    {
      "url": "http://10.111.9.22:3001",
      "description": "Servidor AgendaVest"
    }
  ],
  "tags": [
    {
      "name": "Usuários",
      "description": "Cadastro, autenticação e gerenciamento dos usuários"
    },
    {
      "name": "Administradores",
      "description": "Cadastro, autenticação e validação dos administradores"
    },
    {
      "name": "Vestibulares",
      "description": "Consulta e gerenciamento dos vestibulares"
    },
    {
      "name": "Cursos",
      "description": "Consulta e gerenciamento dos cursos"
    },
    {
      "name": "Provas",
      "description": "Consulta e gerenciamento das provas anteriores"
    },
    {
      "name": "Inscrições",
      "description": "Gerenciamento dos vestibulares adicionados à agenda"
    },
    {
      "name": "Universidades",
      "description": "Consulta das universidades cadastradas"
    },
    {
      "name": "Sugestões",
      "description": "Sugestões enviadas pelos usuários"
    },
    {
      "name": "Scraping",
      "description": "Atualização automática de vestibulares e provas"
    }
  ],
  "components": {
    "securitySchemes": {
      "usuarioAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtido no login do usuário"
      },
      "admAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtido no login do administrador"
      }
    }
  },
  "paths": {
    "/ver_perfil": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Visualizar perfil do usuário",
        "security": [
          {
            "usuarioAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil encontrado com sucesso"
          },
          "401": {
            "description": "Token não informado, inválido ou expirado"
          },
          "500": {
            "description": "Erro interno ao buscar perfil"
          }
        }
      }
    },
    "/cadastro": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Cadastrar usuário",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome_usuario": {
                    "type": "string",
                    "example": "Bia"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "bia@email.com"
                  },
                  "senha": {
                    "type": "string",
                    "format": "password",
                    "example": "123456"
                  },
                  "palavra_chave": {
                    "type": "string",
                    "example": "AgendaVest"
                  },
                  "foto": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "nome_usuario",
                  "email",
                  "senha",
                  "palavra_chave"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cadastro realizado ou validação recusada"
          },
          "500": {
            "description": "Erro interno ao realizar cadastro"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Login do usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "senha": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "email",
                  "senha"
                ]
              },
              "example": {
                "email": "bia@email.com",
                "senha": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login processado"
          },
          "500": {
            "description": "Erro interno ao realizar login"
          }
        }
      }
    },
    "/atualizarSenha": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Atualizar senha do usuário",
        "description": "Atualiza a senha utilizando a palavra-chave cadastrada.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "senha_nova": {
                    "type": "string",
                    "minLength": 6
                  },
                  "palavra_chave": {
                    "type": "string"
                  }
                },
                "required": [
                  "senha_nova",
                  "palavra_chave"
                ]
              },
              "example": {
                "senha_nova": "novaSenha123",
                "palavra_chave": "AgendaVest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atualização de senha processada"
          },
          "500": {
            "description": "Erro interno ao atualizar senha"
          }
        }
      }
    },
    "/atualizarSenhaPerfil": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Atualizar senha pelo perfil",
        "security": [
          {
            "usuarioAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "senha_nova": {
                    "type": "string",
                    "minLength": 6
                  },
                  "palavra_chave": {
                    "type": "string"
                  }
                },
                "required": [
                  "senha_nova",
                  "palavra_chave"
                ]
              },
              "example": {
                "senha_nova": "novaSenha123",
                "palavra_chave": "AgendaVest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atualização de senha processada"
          },
          "401": {
            "description": "Token não informado, inválido ou expirado"
          },
          "500": {
            "description": "Erro interno ao atualizar senha"
          }
        }
      }
    },
    "/atualizar_nomeUsuario": {
      "put": {
        "tags": [
          "Usuários"
        ],
        "summary": "Atualizar nome do usuário",
        "security": [
          {
            "usuarioAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome_usuario": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "required": [
                  "nome_usuario"
                ]
              },
              "example": {
                "nome_usuario": "Novo Nome"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nome atualizado ou validação recusada"
          },
          "401": {
            "description": "Token não informado, inválido ou expirado"
          },
          "500": {
            "description": "Erro interno ao atualizar nome"
          }
        }
      }
    },
    "/atualizar_emailUsuario": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Atualizar e-mail do usuário",
        "security": [
          {
            "usuarioAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email_novo": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "email_novo"
                ]
              },
              "example": {
                "email_novo": "novo@email.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atualização de e-mail processada"
          },
          "401": {
            "description": "Token não informado, inválido ou expirado"
          },
          "500": {
            "description": "Erro interno ao atualizar e-mail"
          }
        }
      }
    },
    "/atualizar_foto": {
      "put": {
        "tags": [
          "Usuários"
        ],
        "summary": "Atualizar foto de perfil",
        "security": [
          {
            "usuarioAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "foto": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "foto"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Foto atualizada com sucesso"
          },
          "400": {
            "description": "Nenhuma foto foi enviada"
          },
          "401": {
            "description": "Token não informado, inválido ou expirado"
          },
          "404": {
            "description": "Usuário não encontrado"
          },
          "500": {
            "description": "Erro interno ao atualizar foto"
          }
        }
      }
    },
    "/deletar_usuario": {
      "delete": {
        "tags": [
          "Usuários"
        ],
        "summary": "Deletar usuário",
        "security": [
          {
            "usuarioAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "senha": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "senha"
                ]
              },
              "example": {
                "senha": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exclusão processada"
          },
          "401": {
            "description": "Token não informado, inválido ou expirado"
          },
          "404": {
            "description": "Usuário não encontrado"
          },
          "500": {
            "description": "Erro interno ao deletar usuário"
          }
        }
      }
    },
    "/cadADM": {
      "post": {
        "tags": [
          "Administradores"
        ],
        "summary": "Cadastrar administrador",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "senha": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "email",
                  "senha"
                ]
              },
              "example": {
                "email": "admin@email.com",
                "senha": "123456"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "ADM cadastrado com sucesso"
          },
          "400": {
            "description": "Preencha todos os campos"
          },
          "409": {
            "description": "Já existe um ADM com esse e-mail"
          },
          "500": {
            "description": "Erro ao cadastrar ADM"
          }
        }
      }
    },
    "/loginADM": {
      "post": {
        "tags": [
          "Administradores"
        ],
        "summary": "Login do administrador",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "senha": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "email",
                  "senha"
                ]
              },
              "example": {
                "email": "admin@email.com",
                "senha": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso"
          },
          "400": {
            "description": "Preencha todos os campos"
          },
          "401": {
            "description": "E-mail ou senha incorretos"
          },
          "500": {
            "description": "Erro no login"
          }
        }
      }
    },
    "/validarADM": {
      "get": {
        "tags": [
          "Administradores"
        ],
        "summary": "Validar autenticação do administrador",
        "security": [
          {
            "admAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "ADM autenticado"
          },
          "401": {
            "description": "Token não informado, inválido ou expirado"
          },
          "403": {
            "description": "Acesso permitido apenas para administradores"
          }
        }
      }
    },
    "/verVest": {
      "get": {
        "tags": [
          "Vestibulares"
        ],
        "summary": "Listar vestibulares",
        "responses": {
          "200": {
            "description": "Lista de vestibulares"
          },
          "500": {
            "description": "Erro ao listar vestibulares"
          }
        }
      }
    },
    "/verVest/{id}": {
      "get": {
        "tags": [
          "Vestibulares"
        ],
        "summary": "Buscar vestibular por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vestibular encontrado"
          },
          "404": {
            "description": "Vestibular não encontrado"
          },
          "500": {
            "description": "Erro ao buscar vestibular"
          }
        }
      }
    },
    "/cadVest": {
      "post": {
        "tags": [
          "Vestibulares"
        ],
        "summary": "Cadastrar vestibular",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vestibular": {
                    "type": "string"
                  },
                  "dt_inicio": {
                    "type": "string",
                    "format": "date"
                  },
                  "dt_fim": {
                    "type": "string",
                    "format": "date"
                  },
                  "dt_prova": {
                    "type": "string",
                    "format": "date"
                  },
                  "taxa": {
                    "type": "number"
                  },
                  "link": {
                    "type": "string"
                  }
                },
                "required": [
                  "vestibular",
                  "dt_inicio",
                  "dt_fim",
                  "dt_prova",
                  "taxa"
                ]
              },
              "example": {
                "vestibular": "FUVEST",
                "dt_inicio": "2026-08-18",
                "dt_fim": "2026-10-07",
                "dt_prova": "2026-11-22",
                "taxa": 211,
                "link": "https://www.fuvest.br/"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vestibular cadastrado"
          },
          "400": {
            "description": "Campos obrigatórios ou datas inválidas"
          },
          "500": {
            "description": "Erro ao cadastrar"
          }
        }
      }
    },
    "/atualVest/{id}": {
      "put": {
        "tags": [
          "Vestibulares"
        ],
        "summary": "Atualizar vestibular",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vestibular": {
                    "type": "string"
                  },
                  "dt_inicio": {
                    "type": "string",
                    "format": "date"
                  },
                  "dt_fim": {
                    "type": "string",
                    "format": "date"
                  },
                  "dt_prova": {
                    "type": "string",
                    "format": "date"
                  },
                  "taxa": {
                    "type": "number"
                  },
                  "link": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vestibular atualizado com sucesso"
          },
          "400": {
            "description": "Datas inválidas"
          },
          "404": {
            "description": "Vestibular não encontrado"
          },
          "500": {
            "description": "Erro ao atualizar"
          }
        }
      }
    },
    "/delVest/{id}": {
      "delete": {
        "tags": [
          "Vestibulares"
        ],
        "summary": "Excluir vestibular",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vestibular deletado com sucesso"
          },
          "404": {
            "description": "Vestibular não encontrado"
          },
          "500": {
            "description": "Erro ao deletar"
          }
        }
      }
    },
