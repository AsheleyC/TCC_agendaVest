    "/addProvas": {
      "post": {
        "tags": [
          "Provas"
        ],
        "summary": "Cadastrar prova",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_vestibular": {
                    "type": "integer"
                  },
                  "link_prova": {
                    "type": "string"
                  },
                  "link_gabarito": {
                    "type": "string"
                  },
                  "ano_prova": {
                    "type": "integer"
                  }
                },
